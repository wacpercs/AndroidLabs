<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".MainActivity">

    <!-- 1. EditText: строка с именем, фамилией и номером группы в качестве ссылки на строковый ресурс -->
    <EditText
        android:id="@+id/editTextStudent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/student_info"
        android:inputType="text"
        android:minHeight="48dp"
        android:autofillHints="" />

    <!-- 2. ImageView: дефолтная иконка приложения, центрированная -->
    <ImageView
        android:id="@+id/imageViewIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="32dp"
        android:src="@mipmap/ic_launcher_round"
        android:contentDescription="@string/app_icon_desc" />

    <!-- 3. Button: кнопка с текстом «ОК» -->
    <Button
        android:id="@+id/buttonOk"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/button_ok" />

</LinearLayout>
